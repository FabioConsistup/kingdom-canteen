# Serviço transacional de e-mail (Resend — https://resend.com)
# Crie a chave no painel do provedor e configure estas variáveis no host.
# NUNCA versione a chave real: este arquivo é apenas um modelo.

# Chave da API do Resend (começa com "re_")
EMAIL_API_KEY=

# Remetente verificado no provedor. O domínio precisa estar validado (SPF/DKIM).
# Ex.: Kingdom Canteen <bonus@kingdomcanteen.cloud>
EMAIL_FROM=

# Caixa que recebe as solicitações. Opcional — o padrão já é o endereço abaixo.
EMAIL_TO=bonus@kingdomcanteen.cloud
